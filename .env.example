# Server-side provider credentials. Never expose these values to the browser.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Provider and model configuration. IMAGE_MODEL is the single model authority.
IMAGE_PROVIDER="openai"
IMAGE_MODEL="gpt-image-2"

# Optional OpenAI request timeout in milliseconds (default 180000).
OPENAI_TIMEOUT_MS=180000

# Server Port (default 3000)
PORT=3000

# Public application URL when deployed.
APP_URL="MY_APP_URL"
