# Server-side Gemini credential. Never expose this value to the browser.
GEMINI_API_KEY=""

# Provider and model configuration. IMAGE_MODEL is the single model authority.
IMAGE_PROVIDER="gemini"
IMAGE_MODEL="gemini-3.1-flash-image"

# Server Port (default 3000)
PORT=3000

# Public application URL when deployed.
APP_URL="MY_APP_URL"
