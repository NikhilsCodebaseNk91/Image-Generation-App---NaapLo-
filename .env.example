# Server-side provider credentials. Never expose these values to the browser.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Provider and model configuration. IMAGE_MODEL is the single model authority.
IMAGE_PROVIDER="openai"
IMAGE_MODEL="gpt-image-2"

# Optional OpenAI request timeout in milliseconds (default 180000).
OPENAI_TIMEOUT_MS=180000

# CP-005 Google Drive source adapter. Keep false until a server-side credential is configured.
DRIVE_ENABLED=false
DRIVE_MASTER_PROMPT_FILE_ID=1fo9itawW0tmmNZki8oGCH2fbcuCgokau
DRIVE_MASTER_PROMPT_MIN_VERSION=1.5.5
DRIVE_LOGO_FILE_ID=1GNRrbtANgGlzuq5FPtU7duJjMEiyQmnX
DRIVE_MULTIPLE_OUTFIT_FILE_ID=13XNkfu35GNBodG1kTnmTmzJ_4Z6Ks3-C
# Prefer a base64-encoded service-account JSON for production. Share the three Drive files with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional short-lived development/test alternative. Never commit a token.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Server Port (default 3000)
PORT=3000

# Public application URL when deployed.
APP_URL="MY_APP_URL"
